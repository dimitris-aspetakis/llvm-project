; CHECK-NEXT:    %j.plus1 = add i32 %j, 1
; CHECK-NEXT:    --> (1 + {0,+[%cond],1}<%loop>) U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %j.next = select i1 %cond, i32 %j.plus1, i32 %j
; CHECK-NEXT:    --> %j.next U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %i.next = add nuw nsw i32 %i, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,-2147483648) S: [1,-2147483648) Exits: %n LoopDispositions: { %loop: Computable }
