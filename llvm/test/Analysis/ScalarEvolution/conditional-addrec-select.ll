  %cond = icmp ne i32 %va, 0
  %j.ext = zext i32 %j to i64
  %c.gep = getelementptr inbounds i32, ptr %c, i64 %j.ext
  store i32 %sum, ptr %c.gep
  %j.plus1 = add i32 %j, 1
  %j.next = select i1 %cond, i32 %j.plus1, i32 %j
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}
