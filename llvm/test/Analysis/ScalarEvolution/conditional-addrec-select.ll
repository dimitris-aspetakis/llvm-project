; Tests for recognition of SCEVConditionalAddRecExpr from the "select form":
;
;   j = phi(Start, select(Cond, j + Step, j))
;       -> { Start, +[Cond], Step }<%loop>
;
; The select form is what appears after simplifycfg/instcombine have merged
; a conditional update into a single block. The split-CFG / phi-merge form
; (as produced by clang before those passes run) is covered separately.

; Canonical: j advances by 1 when cond is true.
define void @conditional_iv_select(i32 %n) {
; CHECK-LABEL: 'conditional_iv_select'
; CHECK-NEXT:  Classifying expressions for: @conditional_iv_select
; CHECK-NEXT:    %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,-2147483648) S: [0,-2147483648) Exits: (-1 + %n) LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %j = phi i32 [ 0, %entry ], [ %j.next, %loop ]
; CHECK-NEXT:    --> {0,+[%cond],1}<%loop> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %j.plus1 = add i32 %j, 1
; CHECK-NEXT:    --> (1 + {0,+[%cond],1}<%loop>) U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %j.next = select i1 %cond, i32 %j.plus1, i32 %j
; CHECK-NEXT:    --> %j.next U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Variant }
; CHECK-NEXT:    %i.next = add nuw nsw i32 %i, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,-2147483648) S: [1,-2147483648) Exits: %n LoopDispositions: { %loop: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @conditional_iv_select
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + %n)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -1
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + %n)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %j = phi i32 [ 0, %entry ], [ %j.next, %loop ]
  %cond = icmp sgt i32 %i, 10
  %j.plus1 = add i32 %j, 1
  %j.next = select i1 %cond, i32 %j.plus1, i32 %j
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

