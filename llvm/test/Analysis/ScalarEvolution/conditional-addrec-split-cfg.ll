; Tests for recognition of SCEVConditionalAddRecExpr from the "split-CFG /
; phi-merge form". Companion to conditional-addrec-select.ll.
;
; Shape: the backedge value of the loop-header phi is itself a merge PHI
; whose two incoming values come from opposite sides of a conditional
; branch. This is what clang emits before simplifycfg/instcombine fold the
; conditional update into a select.
;
;   header:
;     j = phi(Start, j.next)   ; backedge value is a merge PHI
;     br i1 %Cond, %take, %merge
;   take:
;     %inc = add j, Step
;     br label %merge
;   merge:
;     %j.next = phi i32 [ %inc, %take ], [ %j, %header ]
;     br label %latch
;     ...

; Canonical triangle: take-block branches to merge, skip-edge is direct
; from the gate (the header itself here) to merge.
define void @split_cfg_canonical(i32 %n) {
; CHECK-LABEL: 'split_cfg_canonical'
; CHECK-NEXT:  Classifying expressions for: @split_cfg_canonical
; CHECK-NEXT:    %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%header> U: [0,-2147483648) S: [0,-2147483648) Exits: (-1 + %n) LoopDispositions: { %header: Computable }
; CHECK-NEXT:    %j = phi i32 [ 0, %entry ], [ %j.next, %latch ]
; CHECK-NEXT:    --> {0,+[%cond],1}<%header> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Computable }
; CHECK-NEXT:    %j.plus1 = add i32 %j, 1
; CHECK-NEXT:    --> (1 + {0,+[%cond],1}<%header>) U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Computable }
; CHECK-NEXT:    %j.next = phi i32 [ %j.plus1, %take ], [ %j, %header ]
; CHECK-NEXT:    --> %j.next U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %header: Variant }
; CHECK-NEXT:    %i.next = add nuw nsw i32 %i, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%header> U: [1,-2147483648) S: [1,-2147483648) Exits: %n LoopDispositions: { %header: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @split_cfg_canonical
; CHECK-NEXT:  Loop %header: backedge-taken count is (-1 + %n)
; CHECK-NEXT:  Loop %header: constant max backedge-taken count is i32 -1
; CHECK-NEXT:  Loop %header: symbolic max backedge-taken count is (-1 + %n)
; CHECK-NEXT:  Loop %header: Trip multiple is 1
;
entry:
  br label %header

header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %j = phi i32 [ 0, %entry ], [ %j.next, %latch ]
  %cond = icmp sgt i32 %i, 10
  br i1 %cond, label %take, label %merge

take:
  %j.plus1 = add i32 %j, 1
  br label %merge

merge:
  %j.next = phi i32 [ %j.plus1, %take ], [ %j, %header ]
  br label %latch

latch:
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %header

exit:
  ret void
}

