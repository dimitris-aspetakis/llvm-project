; Motivating compressed-store shape from benchmarks/compress_store/filter_pack.c:
;   for (int i = 0; i < n; ++i) if (cond[i]) dst[j++] = src[i];
; Gate is a separate block from the header (for.body in the original). The
; take-arm stores and increments; the skip-edge goes direct from gate to
; merge.
define void @split_cfg_filter_pack(ptr %src, ptr %cond, ptr %dst, i32 %n) {
; CHECK-LABEL: 'split_cfg_filter_pack'
; CHECK-NEXT:  Classifying expressions for: @split_cfg_filter_pack
; CHECK-NEXT:    %i.0 = phi i32 [ 0, %entry ], [ %inc5, %for.inc ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%for.cond> U: [0,-2147483648) S: [0,-2147483648) Exits: (0 smax %n) LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:    %j.0 = phi i32 [ 0, %entry ], [ %j.1, %for.inc ]
; CHECK-NEXT:    --> {0,+[%tobool],1}<%for.cond> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:    %i.ext = sext i32 %i.0 to i64
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%for.cond> U: [0,2147483648) S: [0,2147483648) Exits: (zext i32 (0 smax %n) to i64) LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:    %c.gep = getelementptr inbounds i8, ptr %cond, i64 %i.ext
; CHECK-NEXT:    --> {%cond,+,1}<nw><%for.cond> U: full-set S: full-set Exits: ((zext i32 (0 smax %n) to i64) + %cond) LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:    %c.load = load i8, ptr %c.gep, align 1
; CHECK-NEXT:    --> %c.load U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %for.cond: Variant }
; CHECK-NEXT:    %s.gep = getelementptr inbounds i32, ptr %src, i64 %i.ext
; CHECK-NEXT:    --> {%src,+,4}<nw><%for.cond> U: full-set S: full-set Exits: ((4 * (zext i32 (0 smax %n) to i64))<nuw><nsw> + %src) LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:    %s.load = load i32, ptr %s.gep, align 4
; CHECK-NEXT:    --> %s.load U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %for.cond: Variant }
; CHECK-NEXT:    %inc = add nsw i32 %j.0, 1
; CHECK-NEXT:    --> (1 + {0,+[%tobool],1}<%for.cond>) U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:    %j.ext = sext i32 %j.0 to i64
; CHECK-NEXT:    --> (sext i32 {0,+[%tobool],1}<%for.cond> to i64) U: [-2147483648,2147483648) S: [-2147483648,2147483648) Exits: <<Unknown>> LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:    %d.gep = getelementptr inbounds i32, ptr %dst, i64 %j.ext
; CHECK-NEXT:    --> ((4 * (sext i32 {0,+[%tobool],1}<%for.cond> to i64))<nsw> + %dst) U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:    %j.1 = phi i32 [ %inc, %if.then ], [ %j.0, %for.body ]
; CHECK-NEXT:    --> %j.1 U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %for.cond: Variant }
; CHECK-NEXT:    %inc5 = add nsw i32 %i.0, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><%for.cond> U: [1,-2147483647) S: [1,-2147483647) Exits: (1 + (0 smax %n))<nuw> LoopDispositions: { %for.cond: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @split_cfg_filter_pack
; CHECK-NEXT:  Loop %for.cond: backedge-taken count is (0 smax %n)
; CHECK-NEXT:  Loop %for.cond: constant max backedge-taken count is i32 2147483647
; CHECK-NEXT:  Loop %for.cond: symbolic max backedge-taken count is (0 smax %n)
; CHECK-NEXT:  Loop %for.cond: Trip multiple is 1
;
entry:
  br label %for.cond

for.cond:
  %i.0 = phi i32 [ 0, %entry ], [ %inc5, %for.inc ]
  %j.0 = phi i32 [ 0, %entry ], [ %j.1, %for.inc ]
  %cmp = icmp slt i32 %i.0, %n
  br i1 %cmp, label %for.body, label %for.end

for.body:
  %i.ext = sext i32 %i.0 to i64
  %c.gep = getelementptr inbounds i8, ptr %cond, i64 %i.ext
  %c.load = load i8, ptr %c.gep
  %tobool = icmp ne i8 %c.load, 0
  br i1 %tobool, label %if.then, label %if.end

if.then:
  %s.gep = getelementptr inbounds i32, ptr %src, i64 %i.ext
  %s.load = load i32, ptr %s.gep
  %inc = add nsw i32 %j.0, 1
  %j.ext = sext i32 %j.0 to i64
  %d.gep = getelementptr inbounds i32, ptr %dst, i64 %j.ext
  store i32 %s.load, ptr %d.gep
  br label %if.end

if.end:
  %j.1 = phi i32 [ %inc, %if.then ], [ %j.0, %for.body ]
  br label %for.inc

for.inc:
  %inc5 = add nsw i32 %i.0, 1
  br label %for.cond

for.end:
